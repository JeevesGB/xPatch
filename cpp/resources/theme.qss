QWidget {
    background-color: #000000;
    color: #d4f5fc;
    font-family: Segoe UI;
    font-size: 10pt;
}

QLineEdit, QPlainTextEdit {
    background-color: #3d010e;
    border: 1px solid #444;
    padding: 4px;
    border-radius: 4px;
}

QPushButton {
    background-color: #3d010e;
    border: 1px solid #79021c;
    border-radius: 6px;
    padding: 8px 8px;
    font-weight: bold;
    font-size: 15px;
}

QPushButton:hover {
    background-color: #b6042a;
}

QPushButton:pressed {
    background-color: #f50538;
}


QPushButton#createPatchButton {
    background-color: #2e7d32;
    border: 2px solid #4caf50;
    color: white;
    min-width: 160px;
}

QPushButton#createPatchButton:hover {
    background-color: #388e3c;
}

QPushButton#applyPatchButton {
    background-color: #1976d2;
    border: 2px solid #42a5f5;
    color: white;
    min-width: 160px;
}

QPushButton#applyPatchButton:hover {
    background-color: #1565c0;
}

QPushButton#createPatchButton:checked {
    background-color: #43a047;
    border: 3px solid #ffeb3b;
}

QPushButton#applyPatchButton:checked {
    background-color: #1e88e5;
    border: 3px solid #ffeb3b;
}

QPushButton#createPatchButton:!checked {
    background-color: #1e5f22;     
    border: 2px solid #265d2a;
}

QPushButton#applyPatchButton:!checked {
    background-color: #0f4a7a;     
    border: 2px solid #135e94;
}

QProgressBar {
    border: 2px solid #79021c;
    border-radius: 8px;
    background-color: #000000;
    text-align: center;
    color: #f50538;
    font: bold 12px;
    height: 24px;
}

QProgressBar::chunk {
    border-radius: 6px;
    background: qlineargradient(
        spread: reflect,
        x1: 0, y1: 0.5,
        x2: 1, y2: 0.5,
        stop: 0 #00ddff,
        stop: 0.5 #0099ff,
        stop: 1 #0066ff
    );
}