/* ============================================================
   xPatch  ·  Clean minimal dark
   ============================================================ */

QWidget {
    background-color: #111113;
    color: #c8c8c8;
    font-family: "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
}

QDialog {
    background-color: #111113;
}

/* ---- Labels ---- */
QLabel {
    background: transparent;
    color: #888;
    font-size: 12px;
}

QLabel#appTitle {
    color: #eee;
    font-size: 15px;
    font-weight: 600;
}

QLabel#appSubtitle {
    color: #555;
    font-size: 11px;
}

QLabel#sectionHeader {
    color: #555;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
}

QLabel#fieldLabel {
    color: #777;
    font-size: 12px;
}

QLabel#statusLabel {
    color: #666;
    font-size: 11px;
}

QLabel#statusDot {
    font-size: 9px;
    color: #555;
}

/* ---- Cards / frames ---- */
QFrame#card {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 4px;
}

QFrame#headerBar {
    background-color: #141416;
    border: none;
    border-bottom: 1px solid #27272a;
}

QFrame#separator {
    background-color: #27272a;
    border: none;
    max-height: 1px;
}

/* ---- Inputs ---- */
QLineEdit {
    background-color: #0c0c0e;
    border: 1px solid #2a2a2e;
    border-radius: 3px;
    padding: 6px 8px;
    color: #ddd;
    selection-background-color: #3b82f6;
    selection-color: #fff;
}

QLineEdit:hover {
    border-color: #3a3a40;
}

QLineEdit:focus {
    border-color: #3b82f6;
}

QLineEdit:disabled {
    background-color: #141416;
    color: #444;
    border-color: #222;
}

QLineEdit::placeholder {
    color: #444;
}

/* ---- Buttons base ---- */
QPushButton {
    background-color: #1e1e22;
    border: 1px solid #2a2a2e;
    border-radius: 3px;
    padding: 5px 12px;
    color: #bbb;
    font-weight: 500;
    font-size: 12px;
    min-height: 16px;
}

QPushButton:hover {
    background-color: #26262b;
    border-color: #3a3a40;
    color: #eee;
}

QPushButton:pressed {
    background-color: #18181b;
}

QPushButton:disabled {
    background-color: #161618;
    color: #444;
    border-color: #222;
}

/* Mode toggles */
QPushButton#createPatchButton,
QPushButton#applyPatchButton {
    background-color: transparent;
    border: 1px solid #2a2a2e;
    color: #777;
    min-width: 110px;
    font-weight: 500;
    border-radius: 3px;
    padding: 5px 14px;
}

QPushButton#createPatchButton:hover {
    background-color: #14201a;
    border-color: #2a4a35;
    color: #6bbf8a;
}

QPushButton#createPatchButton:checked {
    background-color: #166534;
    border-color: #22c55e;
    color: #fff;
}

QPushButton#createPatchButton:!checked {
    background-color: transparent;
    border-color: #2a2a2e;
    color: #555;
}

QPushButton#applyPatchButton:hover {
    background-color: #141c28;
    border-color: #2a4060;
    color: #7aabdf;
}

QPushButton#applyPatchButton:checked {
    background-color: #1e40af;
    border-color: #3b82f6;
    color: #fff;
}

QPushButton#applyPatchButton:!checked {
    background-color: transparent;
    border-color: #2a2a2e;
    color: #555;
}

/* Primary action */
QPushButton#actionButton {
    background-color: #2563eb;
    border: 1px solid #2563eb;
    color: #fff;
    font-weight: 600;
    font-size: 13px;
    padding: 7px 16px;
    border-radius: 3px;
    min-height: 18px;
}

QPushButton#actionButton:hover {
    background-color: #3b82f6;
    border-color: #3b82f6;
}

QPushButton#actionButton:pressed {
    background-color: #1d4ed8;
}

QPushButton#actionButton:disabled {
    background-color: #1a2a4a;
    border-color: #1a2a4a;
    color: #556;
}

/* Secondary / ghost */
QPushButton#secondaryButton {
    background-color: transparent;
    border: 1px solid #2a2a2e;
    color: #777;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 3px;
}

QPushButton#secondaryButton:hover {
    background-color: #1e1e22;
    border-color: #3a3a40;
    color: #ccc;
}

/* Browse */
QPushButton#browseButton {
    background-color: #1e1e22;
    border: 1px solid #2a2a2e;
    color: #888;
    padding: 6px 10px;
    min-width: 60px;
    border-radius: 3px;
    font-size: 12px;
}

QPushButton#browseButton:hover {
    background-color: #26262b;
    border-color: #3a3a40;
    color: #ccc;
}

/* ---- Progress ---- */
QProgressBar {
    border: 1px solid #2a2a2e;
    border-radius: 3px;
    background-color: #0c0c0e;
    text-align: center;
    color: #ccc;
    font-weight: 500;
    font-size: 11px;
    height: 18px;
}

QProgressBar::chunk {
    border-radius: 2px;
    background-color: #2563eb;
    margin: 1px;
}

/* ---- Console ---- */
QPlainTextEdit#console {
    background-color: #0a0a0c;
    border: 1px solid #222;
    border-radius: 3px;
    padding: 8px 10px;
    color: #888;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 11px;
    selection-background-color: #2563eb;
    selection-color: #fff;
}

QPlainTextEdit#console:focus {
    border-color: #2a2a2e;
}

/* ---- Scrollbars ---- */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px 1px 2px 0;
}

QScrollBar::handle:vertical {
    background: #2a2a2e;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #3a3a40;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0 2px 1px 2px;
}

QScrollBar::handle:horizontal {
    background: #2a2a2e;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #3a3a40;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    width: 0;
    background: transparent;
}

/* ---- Dialogs ---- */
QTextBrowser {
    background-color: #0c0c0e;
    border: 1px solid #27272a;
    border-radius: 3px;
    padding: 12px;
    color: #bbb;
}

QTextBrowser a {
    color: #3b82f6;
}

QToolTip {
    background-color: #1e1e22;
    color: #ccc;
    border: 1px solid #2a2a2e;
    padding: 4px 8px;
    border-radius: 2px;
    font-size: 11px;
}

QMessageBox {
    background-color: #111113;
}

QMessageBox QLabel {
    color: #bbb;
}
